# ClickUp API Configuration
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_TEAM_ID=your_team_id_here

# Optional: API Base URL (usually doesn't need to change)
CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2

# Optional: Rate limiting delay in microseconds (default: 600000 = 0.6 seconds)
# ClickUp allows 100 requests per minute, so 0.6 seconds between calls is safe
CLICKUP_RATE_LIMIT_DELAY=600000
